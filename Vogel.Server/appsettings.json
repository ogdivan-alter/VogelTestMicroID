{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Vogel": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/vogel-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AuthProvider": "Api",
  "MicroId": {
    "BaseUrl": "http://localhost:8021",
    "SystemId": "MICROID",
    "SystemNumericId": 1,
    "TimeoutSeconds": 30,
    "CredRenovation": "MONTHLY"
  },
  "ApiBackend": {
    "BaseUrl": "http://localhost:5041"
  },
  "InactivityTimeoutMinutes": 15,
  "SecurityHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-XSS-Protection": "1; mode=block",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' http://localhost:5041 data: https:; connect-src 'self' http://localhost:5041 https: ws: wss:; frame-src 'self' https://www.google.com/recaptcha/;"
  },
  "RememberMe": {
    "Enabled": true,
    "DisplayText": "Recordar Sesión"
  },
  "Recaptcha": {
    "Mode": "Disabled",
    "SiteKey": ""
  },
  "SessionValidation": {
    "TtlSeconds": 10
  },
  "AllowedHosts": "*"
}