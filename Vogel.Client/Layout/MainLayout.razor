@inherits MainLayoutBase

<!-- Shell principal de la aplicación Vogel (Sprint 3) -->
<div class="vogel-shell">

    <!-- Monitor de inactividad global -->
    @if (SessionState.IsAuthenticated)
    {
        <InactivityMonitor TimeoutMinutes="@InactivityTimeoutMinutes" />
    }

    <!-- ===== HEADER ===== -->
    <header class="vogel-header" role="banner">
        <!-- Logotipo / Marca (clic redirige a MainView '/') -->
        <a href="/" class="brand" aria-label="Vogel - Inicio">
            <span class="brand-icon" aria-hidden="true">V</span>
            <span class="brand-name">Vogel</span>
        </a>

        <div class="spacer"></div>

        <!-- Bloque de usuario (solo visible si está autenticado) -->
        @if (SessionState.IsAuthenticated && SessionState.CurrentUser != null)
        {
            <!-- Botón tipo burger para vista responsive en dispositivos móviles -->
            <button class="burger-btn"
                    @onclick="ToggleMobileMenu"
                    aria-label="Alternar menú de usuario"
                    aria-expanded="@IsMobileMenuOpen">
                <img src="icons/menu.svg" alt="" aria-hidden="true" />
            </button>

            <div class="user-block @(IsMobileMenuOpen ? "mobile-open" : "")" role="navigation" aria-label="Menú de usuario">
                <!-- 1. Info usuario (username + avatar) -->
                <div class="user-info" title="@(SessionState.CurrentUser.Name ?? SessionState.CurrentUser.Username)">
                    <div class="user-avatar" aria-hidden="true">
                        @GetUserInitials()
                    </div>
                    <span class="user-name">@SessionState.CurrentUser.Username</span>
                </div>

                <!-- 2. Cambio de clave (solo visible si allow_password_change está activo) -->
                @if (SessionState.CurrentUser.AllowPasswordChange)
                {
                    <a href="/change-password"
                       id="btn-change-password"
                       class="vogel-btn vogel-btn--header vogel-btn--sm"
                       title="Cambiar Contraseña"
                       aria-label="Cambiar Contraseña">
                        <img src="icons/lock.svg" alt="" aria-hidden="true" class="vogel-btn__icon" />
                        <span>Cambiar Clave</span>
                    </a>
                }

                <!-- 3. Cierre de sesión (botón con ícono diferenciado del botón Salir de HeaderWork) -->
                <button id="btn-logout"
                        class="vogel-btn vogel-btn--danger-outline vogel-btn--sm"
                        title="Cierre de Sesión"
                        @onclick="HandleLogoutAsync"
                        disabled="@IsLoggingOut"
                        aria-label="Cierre de Sesión">
                    @if (IsLoggingOut)
                    {
                        <span class="btn-spinner" role="status" aria-hidden="true"></span>
                    }
                    else
                    {
                        <img src="icons/logout.svg" alt="" aria-hidden="true" class="vogel-btn__icon" />
                        <span>Cierre de Sesión</span>
                    }
                </button>
            </div>
        }
    </header>

    <!-- ===== CUERPO ===== -->
    <div class="vogel-body" role="main">
        <div class="vogel-page-content">
            @Body
        </div>
    </div>

    <!-- ===== FOOTER (DefaultFooter Component) ===== -->
    <DefaultFooter CompanyName="Vogel" ApplicationTitle="Sistema de Gestión" Version="v1.0.0" />

    <!-- Overlay de carga global (durante logout u operaciones asíncronas) -->
    @if (IsLoggingOut)
    {
        <div class="global-overlay" role="status" aria-live="polite" aria-label="Cerrando sesión...">
            <div class="spinner" aria-hidden="true"></div>
            <span class="spinner-text">Cerrando sesión...</span>
        </div>
    }

</div>
