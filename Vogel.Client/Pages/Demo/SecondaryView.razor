@page "/secondary/{IdParent:int}"
@namespace Vogel.Client.Pages

<div class="vogel-secondary-view">
    <HeaderWork Title="@Title" 
                Color="@HeaderColor" 
                TextExit="@TextExit" 
                ActionExit="@ActionExit" />

    <main class="vogel-secondary-view__body" role="main">
        <div class="vogel-secondary-view__container">
            <SecondaryMenu IdParent="@IdParent" />
        </div>
    </main>
</div>
