@namespace Vogel.Client.Pages.TreeWork.AdmTools.AdmSecurity.AdmPriv

<InfoViewFrame Title="Información del Sistema">
    <div class="vogel-master-card">
        <div class="vogel-master-field">
            <span class="vogel-master-field__label">Sistema:</span>
            <span class="vogel-badge vogel-badge--info">@DisplaySystemCode</span>
        </div>
        <div class="vogel-master-field">
            <span class="vogel-master-field__label">Privilegios mostrados:</span>
            <strong class="vogel-master-field__value">@AdmPrivState.TotalFilteredCount</strong>
        </div>
    </div>
</InfoViewFrame>
