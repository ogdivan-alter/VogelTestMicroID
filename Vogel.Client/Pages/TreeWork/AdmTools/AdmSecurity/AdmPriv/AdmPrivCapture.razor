@namespace Vogel.Client.Pages.TreeWork.AdmTools.AdmSecurity.AdmPriv

@if (CanCreate)
{
    <div class="vogel-filter-panel adm-priv-capture">
        <div class="vogel-work-toolbar__group adm-priv-capture__actions">
            <button type="button"
                    class="adm-priv-capture__btn-create"
                    @onclick="HandleCreatePrivilegeClick">
                <img src="icons/plus.svg"
                     alt=""
                     aria-hidden="true"
                     class="adm-priv-capture__icon" />
                <span>Crear privilegio</span>
            </button>
        </div>
    </div>
}
