@namespace Vogel.Client.Pages.TreeWork.AdmTools.AdmSecurity.AdmPriv

<div class="vogel-filter-panel adm-priv-filter" role="search" aria-label="Filtros de privilegios">
    <div class="adm-priv-filter__row">
        <span id="adm-priv-filter-status-label"
              class="vogel-master-field__label adm-priv-filter__label">ESTADO</span>
        <div class="adm-priv-filter__control adm-priv-filter__status"
             role="radiogroup"
             aria-labelledby="adm-priv-filter-status-label">
            <label class="adm-priv-filter__radio">
                <input type="radio"
                       name="admPrivStatus"
                       value="A"
                       checked="@IsStatusSelected("A")"
                       @onchange="@(() => HandleStatusChanged("A"))" />
                <span>Activos</span>
            </label>
            <label class="adm-priv-filter__radio">
                <input type="radio"
                       name="admPrivStatus"
                       value="I"
                       checked="@IsStatusSelected("I")"
                       @onchange="@(() => HandleStatusChanged("I"))" />
                <span>Inactivos</span>
            </label>
            <label class="adm-priv-filter__radio">
                <input type="radio"
                       name="admPrivStatus"
                       value="ALL"
                       checked="@IsStatusSelected("ALL")"
                       @onchange="@(() => HandleStatusChanged("ALL"))" />
                <span>Todos</span>
            </label>
        </div>
    </div>

    <div class="adm-priv-filter__row">
        <label for="adm-priv-filter-title"
               class="vogel-master-field__label adm-priv-filter__label">TÍTULO</label>
        <div class="adm-priv-filter__control vogel-filter-panel__search adm-priv-filter__search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="vogel-search-icon" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input id="adm-priv-filter-title"
                   type="text"
                   class="vogel-input vogel-filter-input"
                   placeholder="Filtrar por título (title)..."
                   value="@AdmPrivState.TitleFilter"
                   @oninput="HandleTitleInput" />
            @if (HasTitleFilter)
            {
                <button type="button"
                        class="vogel-btn-clear"
                        title="Limpiar filtro de título"
                        aria-label="Limpiar filtro de título"
                        @onclick="ClearTitleFilter">&times;</button>
            }
        </div>
    </div>

    <div class="adm-priv-filter__row">
        <label for="adm-priv-filter-parent"
               class="vogel-master-field__label adm-priv-filter__label">ID_PARENT</label>
        <div class="adm-priv-filter__control adm-priv-filter__parent">
            <input id="adm-priv-filter-parent"
                   type="number"
                   class="vogel-input vogel-filter-input adm-priv-filter__parent-input"
                   placeholder="Filtrar por id_parent..."
                   value="@AdmPrivState.IdParentFilter"
                   @oninput="HandleIdParentInput" />
            @if (HasIdParentFilter)
            {
                <button type="button"
                        class="vogel-btn-clear"
                        title="Limpiar filtro de id_parent"
                        aria-label="Limpiar filtro de id_parent"
                        @onclick="ClearIdParentFilter">&times;</button>
            }
        </div>
    </div>
</div>
