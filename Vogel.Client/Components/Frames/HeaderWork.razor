@namespace Vogel.Client.Components

<header class="vogel-header-work" style="background-color: @Color;" role="banner">
    <div class="vogel-header-work__container">
        <div class="vogel-header-work__title-wrapper">
            <h2 class="vogel-header-work__title">@Title</h2>
        </div>

        <div class="vogel-header-work__actions">
            <button type="button" 
                    class="vogel-header-work__btn-exit" 
                    @onclick="HandleExitAsync" 
                    disabled="@_isProcessing"
                    aria-label="@TextExit">
                <svg class="vogel-header-work__exit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                    <polyline points="16 17 21 12 16 7"></polyline>
                    <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                <span>@TextExit</span>
            </button>
        </div>
    </div>
</header>
