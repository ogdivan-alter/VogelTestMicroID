@namespace Vogel.Client.Components

<header class="vogel-header-work" style="background-color: @Color;" role="banner">
    <div class="vogel-header-work__container">
        <div class="vogel-header-work__title-wrapper">
            <h2 class="vogel-header-work__title">@Title</h2>
        </div>

        <div class="vogel-header-work__actions">
            <button type="button"
                    class="vogel-btn vogel-btn--header"
                    @onclick="HandleExitAsync"
                    disabled="@_isProcessing"
                    aria-label="@TextExit">
                <img src="icons/exit.svg" alt="" aria-hidden="true" class="vogel-btn__icon" />
                <span>@TextExit</span>
            </button>
        </div>
    </div>
</header>
