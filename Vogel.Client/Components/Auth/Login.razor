@namespace Vogel.Client.Components
@inherits LoginBase

<div class="login-component" role="form" aria-label="Componente de inicio de sesión">
    <!-- Alerta de error -->
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div id="login-error-alert" class="login-error-alert" role="alert" aria-live="assertive">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                 fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10" />
                <line x1="12" y1="8" x2="12" y2="12" />
                <line x1="12" y1="16" x2="12.01" y2="16" />
            </svg>
            <span>@ErrorMessage</span>
        </div>
    }

    <EditForm id="login-form" Model="@FormModel" OnValidSubmit="@HandleSubmitAsync">
        <DataAnnotationsValidator />

        <!-- Campo Usuario -->
        <div class="form-group">
            <label for="input-username" class="form-label">Usuario</label>
            <InputText @ref="UsernameInput"
                       id="input-username"
                       class="form-control"
                       @bind-Value="FormModel.Username"
                       placeholder="Ingrese su usuario"
                       autocomplete="username"
                       disabled="@IsLoading"
                       autofocus
                       aria-required="true"
                       aria-describedby="err-username" />
            <ValidationMessage For="@(() => FormModel.Username)" id="err-username" class="field-error" role="alert" />
        </div>

        <!-- Campo Contraseña -->
        <div class="form-group">
            <label for="input-password" class="form-label">Contraseña</label>
            <InputText id="input-password"
                       type="password"
                       class="form-control"
                       @bind-Value="FormModel.Password"
                       placeholder="Ingrese su contraseña"
                       autocomplete="current-password"
                       disabled="@IsLoading"
                       aria-required="true"
                       aria-describedby="err-password" />
            <ValidationMessage For="@(() => FormModel.Password)" id="err-password" class="field-error" role="alert" />
        </div>

        <!-- Opción Recordar Sesión (configurable) -->
        @if (ShowRememberMe)
        {
            <div class="form-check">
                <InputCheckbox id="chk-remember"
                               class="form-check-input"
                               @bind-Value="FormModel.RememberMe"
                               disabled="@IsLoading" />
                <label for="chk-remember" class="form-check-label">
                    @RememberMeText
                </label>
            </div>
        }

        <!-- reCAPTCHA configurable -->
        <ReCaptcha @ref="ReCaptchaComponent"
                   Mode="@RecaptchaMode"
                   SiteKey="@RecaptchaSiteKey"
                   ConditionMet="@RecaptchaConditionMet"
                   OnVerifiedChanged="@HandleRecaptchaVerifiedChanged" />

        <!-- Botones de Acción: Ingresar y Cancelar (opcional según parámetro) -->
        <div class="login-actions">
            <button id="btn-login"
                    type="submit"
                    class="btn btn-primary @(ShowCancelButton ? "" : "btn-block")"
                    disabled="@(IsLoading || (ReCaptchaComponent != null && ReCaptchaComponent.IsVisible && !IsRecaptchaVerified))"
                    aria-busy="@IsLoading.ToString().ToLower()">
                @if (IsLoading)
                {
                    <span class="btn-spinner" role="status" aria-hidden="true"></span>
                    <span>Autenticando...</span>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10,17 15,12 10,7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    <span>Ingresar</span>
                }
            </button>

            @if (ShowCancelButton)
            {
                <button id="btn-cancel"
                        type="button"
                        class="btn btn-secondary"
                        @onclick="HandleCancelAsync"
                        disabled="@IsLoading"
                        title="Cancelar"
                        aria-label="Cancelar operación">
                    <span>Cancelar</span>
                </button>
            }

            @if (!IsLoading && ShowClearButton)
            {
                <button id="btn-clear-form"
                        type="button"
                        class="btn btn-secondary"
                        @onclick="ClearForm"
                        title="Limpiar formulario"
                        aria-label="Limpiar campos del formulario">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <polyline points="1,4 1,10 7,10"/>
                        <path d="M3.51 15a9 9 0 1 0 .49-4.95"/>
                    </svg>
                </button>
            }
        </div>
    </EditForm>
</div>

