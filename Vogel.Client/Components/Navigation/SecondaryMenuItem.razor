@namespace Vogel.Client.Components

<div class="vogel-secondary-card @(_isProcessing ? "vogel-secondary-card--busy" : "")"
     @onclick="HandleClickAsync"
     role="button"
     tabindex="0"
     aria-label="@Title"
     title="@Title">
    <div class="vogel-secondary-card__icon-container">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <img src="@Icon" alt="@Title" class="vogel-secondary-card__icon" loading="lazy" />
        }
        else if (Title.Equals("Usuarios", StringComparison.OrdinalIgnoreCase))
        {
            <img src="icons/users.svg" alt="@Title" class="vogel-secondary-card__icon" loading="lazy" />
        }
        else if (Title.Equals("Roles", StringComparison.OrdinalIgnoreCase))
        {
            <img src="icons/roles.svg" alt="@Title" class="vogel-secondary-card__icon" loading="lazy" />
        }
        else
        {
            <div class="vogel-secondary-card__icon-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
            </div>
        }
    </div>

    <div class="vogel-secondary-card__title-container">
        <span class="vogel-secondary-card__title">@Title</span>
    </div>

    @if (_isProcessing)
    {
        <div class="vogel-secondary-card__loader">
            <span class="vogel-spinner-small"></span>
        </div>
    }
</div>
